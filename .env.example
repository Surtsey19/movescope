# Which backend to use for the vision/language model: "meta" or "baseten"
MUSE_SPARK_PROVIDER=baseten

# Meta Model API (base URL https://api.meta.ai/v1, OpenAI-SDK-kompatibel)
META_API_KEY=
META_SAM_MODEL=sam-3.1
META_MUSE_SPARK_MODEL=muse-spark-1.3

# Baseten (base URL https://inference.baseten.co/v1), used if MUSE_SPARK_PROVIDER=baseten
BASETEN_API_KEY=
BASETEN_MUSE_SPARK_MODEL=meta-models/muse-spark-open-1026

# Set to "true"/"false" to force mock mode on/off. If unset, mock mode is
# used automatically whenever no API key is configured.
MOCK_MODE=
